{
  "expo": {
    "name": "para",
    "slug": "para",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "para",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F9FF",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ph.para.app",
      "googleServicesFile": "./configuration/google-services/staging/ios/GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF5500",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ph.para.app",
      "googleServicesFile": "./configuration/google-services/staging/android/google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBfC23rGQM36kuSs7XXsZgYv-HYwBu7D3E"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#FF5500"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Para uses the camera to scan the activation code your fleet shows you.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para uses your location to find your nearest jeepney stop. Drivers share their jeepney's live location with their fleet and commuters while in service.",
          "locationAlwaysAndWhenInUsePermission": "Drivers: Para keeps sharing your jeepney's location while you are in service, even with the phone locked, so commuters don't lose your jeepney. It stops when you go on break or sign out.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (via react-native-maps) builds its Room database by reflection: keep the generated classes,\n# or the release build crashes on launch (Failed to create an instance of class androidx.work.impl.WorkDatabase).\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.impl.WorkDatabase { *; }"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8514386763089736~1325213937",
          "iosAppId": "ca-app-pub-8514386763089736~8601068724"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appEnv": "staging",
      "androidMapsKey": true,
      "google": {
        "webClientId": "127857951457-viv7ugiqh6t70f7viqqeg252ogse376k.apps.googleusercontent.com",
        "iosClientId": "127857951457-jvrje849hr78dbsesn6qvqtd8ai9r3fj.apps.googleusercontent.com"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "64dc1093-b8c9-4478-be12-6ecf56f996c6"
      }
    },
    "owner": "dolfsupremes-team",
    "updates": {
      "url": "https://u.expo.dev/64dc1093-b8c9-4478-be12-6ecf56f996c6"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
