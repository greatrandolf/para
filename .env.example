# Para driver/commuter app settings. Copy to .env.local (git-ignored) and fill in.
# With no Firebase API key the app uses the local emulators (see para-backend/docs/deployment.md).

# Firebase web config (Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Realtime Database (live driver GPS), e.g. https://para-a9efb-default-rtdb.asia-southeast1.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
# Deployed callable functions, e.g. https://asia-southeast1-<project>.cloudfunctions.net
EXPO_PUBLIC_FUNCTIONS_URL=

# Google sign-in for commuters (needs a development or store build, not Expo Go).
# Normally read from configuration/google-services/<APP_ENV>/ by app.config.ts; set these only to override.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional: where the local emulators run, as seen from a physical phone (your Mac's LAN IP).
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.45

# Google Maps SDK for Android key, for the Live Map in Android builds (iOS uses Apple Maps; Expo Go has its own).
# Not EXPO_PUBLIC_: it goes only into the Android manifest at build time. Without it the map shows a notice.
# GOOGLE_MAPS_ANDROID_API_KEY=
